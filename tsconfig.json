{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2024",
			"DOM",
			"WebWorker.ImportScripts",
			"ScriptHost",
			"DOM.Iterable",
			"DOM.AsyncIterable"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noImplicitReturns": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": [
		".pi/extensions/**/*.ts",
		"extensions/**/*.ts",
		"extensions/agent-browser/lib/config-policy.js",
		"extensions/agent-browser/lib/config-providers.js",
		"extensions/agent-browser/lib/config-validation.js",
		"scripts/**/*.ts",
		"test/**/*.ts"
	]
}
