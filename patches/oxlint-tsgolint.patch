+		{Code: "function foo(arg: number & { readonly attached: { value: number } }) {}", Errors: []rule_tester.InvalidTestCaseError{{MessageId: "shouldBeReadonly", Column: 14}}},
+		{Code: "type Token = number & { readonly brand: unique symbol }; function foo(arg: { token: Token }) {}", Errors: []rule_tester.InvalidTestCaseError{{MessageId: "shouldBeReadonly", Column: 71}}},
+		{Code: "type Token = number & { readonly brand: unique symbol }; function foo(arg: { readonly nested: { token: Token } }) {}", Errors: []rule_tester.InvalidTestCaseError{{MessageId: "shouldBeReadonly", Column: 71}}},
+		{Code: "import './augmentation.js';\nfunction f(value: ReadonlyMap<string, number>): void {}", Files: map[string]string{"augmentation.ts": "export {}; declare global { interface ReadonlyMap<K, V> { counter: number } }"}, Errors: []rule_tester.InvalidTestCaseError{{MessageId: "shouldBeReadonly", Line: 2}}},
