+					}
+				}
+			}
+			return true, nil
+		}
+		typed := utils.TypeMatchesSomeSpecifier(ctx.TypeChecker.GetTypeAtLocation(node), nodeRequireSpecifiers, ctx.Program)
+		symbol := callReferenceSymbol(node, ctx.TypeChecker)
+		if symbol != nil {
+			symbol = bindingReferenceSymbol(checker.SkipAlias(symbol, ctx.TypeChecker), ctx.TypeChecker, nil)
+		}
+		if symbol == nil {
+			return typed, nil
+		}
+		if seen[symbol] {
+			return typed, nil
+		}
+		seen[symbol] = true
+		declaration := symbol.ValueDeclaration
+		if declaration != nil && ast.IsVariableDeclaration(declaration) && declaration.Parent.Flags&ast.NodeFlagsConst != 0 && declaration.Initializer() != nil {
+			return visit(declaration.Initializer())
+		}
+		if utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, nodeRequireValueSpecifier, ctx.Program) {
+			if ast.IsIdentifier(node) && declaration != nil && isFreeCallDeclaration(declaration) {
+				return true, ast.GetSourceFileOfNode(node)
+			}
+			if ast.IsAccessExpression(node) {
