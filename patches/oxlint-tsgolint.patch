+
+func isNodeRequireValueReference(node *ast.Node, ctx rule.RuleContext) bool {
+	if node.Parent != nil && ast.IsAccessExpression(node.Parent) && node.Parent.Expression() != node {
+		node = node.Parent
+	}
+	for node.Parent != nil && unwrapCallReference(node.Parent) == node {
+		node = node.Parent
+	}
+	parent := node.Parent
+	if parent == nil {
+		return false
+	}
+	if ast.IsCallExpression(parent) && parent.AsCallExpression().Expression == node {
+		return true
+	}
+	if ast.IsAccessExpression(parent) && parent.Expression() == node {
+		name, known := checker.Checker_getAccessedPropertyName(ctx.TypeChecker, parent)
+		if known && (name == "call" || name == "apply") {
+			symbol := callReferenceSymbol(parent, ctx.TypeChecker)
+			if symbol != nil && len(symbol.Declarations) != 0 && utils.Every(symbol.Declarations, func(declaration *ast.Node) bool {
+				return utils.IsSourceFileDefaultLibrary(ctx.Program, ast.GetSourceFileOfNode(declaration))
+			}) {
+				return false
+			}
+		}
+		return known
+	}
+	return ast.IsVariableDeclaration(parent) && parent.Initializer() == node && parent.Parent.Flags&ast.NodeFlagsConst != 0 && ast.IsIdentifier(parent.Name())
+}
+
+func isSuiteModuleReference(node *ast.Node, ctx rule.RuleContext) bool {
+	for node.Parent != nil && ast.IsParenthesizedExpression(node.Parent) {
+		node = node.Parent
+	}
+	parent := node.Parent
+	if parent == nil {
+		return false
+	}
+	if ast.IsAccessExpression(parent) && parent.Expression() == node {
+		_, known := checker.Checker_getAccessedPropertyName(ctx.TypeChecker, parent)
+		return known
+	}
+	if !ast.IsVariableDeclaration(parent) || parent.Initializer() != node || parent.Parent.Flags&ast.NodeFlagsConst == 0 {
+		return false
+	}
+	if ast.IsIdentifier(parent.Name()) {
+		return true
+	}
+	if ast.IsObjectBindingPattern(parent.Name()) {
+		return utils.Every(parent.Name().AsBindingPattern().Elements.Nodes, func(element *ast.Node) bool {
+			property := element.PropertyNameOrName()
+			return ast.IsIdentifier(element.Name()) && element.AsBindingElement().DotDotDotToken == nil && element.Initializer() == nil && (ast.IsIdentifier(property) || ast.IsStringLiteral(property))
+		})
+	}
+	return false
+}
+
+func isSuiteCallbackReference(node *ast.Node, ctx rule.RuleContext) bool {
+	for node.Parent != nil {
+		parent := node.Parent
+		if unwrapCallReference(parent) == node {
+			node = parent
+			continue
+		}
+		if ast.IsAccessExpression(parent) {
+			if parent.Expression() != node {
+				node = parent
+				continue
+			}
+			if parent.Parent != nil && boundCallTarget(parent.Parent, ctx.Program, ctx.TypeChecker) == node {
+				node = parent.Parent
+				continue
+			}
+		}
+		if ast.IsVariableDeclaration(parent) && parent.Initializer() == node {
+			return parent.Parent.Flags&ast.NodeFlagsConst != 0
+		}
+		if ast.IsBindingElement(parent) && parent.PropertyNameOrName() == node && ast.IsObjectBindingPattern(parent.Parent) {
+			variable := parent.Parent.Parent
+			return ast.IsVariableDeclaration(variable) && variable.Parent.Flags&ast.NodeFlagsConst != 0 && parent.Initializer() == nil && parent.AsBindingElement().DotDotDotToken == nil
+		}
+		if ast.IsCallExpression(parent) && slices.Contains(parent.AsCallExpression().Arguments.Nodes, node) {
+			return matchesSafeCall(parent.AsCallExpression().Expression, nodeSuiteSpecifiers, ctx.Program, ctx.TypeChecker)
+		}
+		return false
+	}
+	return false
+}
+
+func nearestFunction(node *ast.Node) *ast.Node {
+	for parent := node.Parent; parent != nil; parent = parent.Parent {
+		if ast.IsFunctionLike(parent) {
+			return parent
+		}
+	}
+	return nil
+}
