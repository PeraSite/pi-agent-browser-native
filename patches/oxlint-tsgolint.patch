+func isAllowedArrayAlias(
+	program *compiler.Program,
+	typeChecker *checker.Checker,
+	annotation *ast.Node,
+	allow []utils.TypeOrValueSpecifier,
+	seen map[*ast.Symbol]struct{},
+) bool {
+	if annotation == nil {
+		return false
+	}
+	var name *ast.Node
+	switch annotation.Kind {
+	case ast.KindTypeReference:
+		reference := annotation.AsTypeReferenceNode()
+		if reference.TypeArguments != nil {
+			return false
+		}
+		name = reference.TypeName
+	case ast.KindImportType:
+		reference := annotation.AsImportTypeNode()
+		if reference.IsTypeOf || reference.TypeArguments != nil {
+			return false
+		}
+		name = reference.Qualifier
+	default:
+		return false
+	}
+	if name == nil {
+		return false
+	}
+	symbol := typeChecker.GetSymbolAtLocation(name)
+	if symbol == nil {
+		return false
+	}
+	symbol = checker.SkipAlias(symbol, typeChecker)
+	if symbol == nil || symbol.Flags&ast.SymbolFlagsTypeAlias == 0 {
+		return false
+	}
+	if _, ok := seen[symbol]; ok {
+		return false
+	}
+	seen[symbol] = struct{}{}
+	for _, declaration := range symbol.Declarations {
+		if !ast.IsTypeOrJSTypeAliasDeclaration(declaration) || declaration.AsTypeAliasDeclaration().TypeParameters != nil {
+			continue
+		}
+		if utils.Some(allow, func(specifier utils.TypeOrValueSpecifier) bool {
+			return utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, specifier, program)
+		}) {
+			return true
+		}
+		if isAllowedArrayAlias(program, typeChecker, declaration.Type(), allow, seen) {
+			return true
+		}
+	}
+	return false
+}
