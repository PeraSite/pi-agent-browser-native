diff --git a/internal/rules/no_floating_promises/safe_calls.go b/internal/rules/no_floating_promises/safe_calls.go
new file mode 100644
index 0000000..fcebc0f
--- /dev/null
+++ b/internal/rules/no_floating_promises/safe_calls.go
@@ -0,0 +1,198 @@
+package no_floating_promises
+
+import (
+	"slices"
+
+	"github.com/microsoft/typescript-go/shim/ast"
+	"github.com/microsoft/typescript-go/shim/checker"
+	"github.com/microsoft/typescript-go/shim/compiler"
+	"github.com/typescript-eslint/tsgolint/internal/utils"
+)
+
+// Safe calls describe declaration ownership, not a callable type. A context
+// method can have exactly the same type as an approved registration function.
+func unwrapCallReference(node *ast.Node) *ast.Node {
+	for ast.IsParenthesizedExpression(node) || ast.IsAsExpression(node) || ast.IsTypeAssertion(node) || ast.IsSatisfiesExpression(node) || ast.IsNonNullExpression(node) {
+		node = node.Expression()
+	}
+	return node
+}
+
+func isFreeCallDeclaration(node *ast.Node) bool {
+	parent := node.Parent
+	if ast.IsVariableDeclaration(node) && parent != nil && ast.IsVariableDeclarationList(parent) && parent.Parent != nil && ast.IsVariableStatement(parent.Parent) {
+		parent = parent.Parent.Parent
+	} else if !ast.IsFunctionDeclaration(node) {
+		return false
+	}
+	return parent != nil && (parent.Kind == ast.KindSourceFile || parent.Kind == ast.KindModuleBlock)
+}
+
+// Dot/literal-key access and immutable bindings select the same declaration.
+// Keep aliases intact: a native library can expose an approved export name.
+func bindingReferenceSymbol(symbol *ast.Symbol, typeChecker *checker.Checker, acceptsSource func(*ast.Node) bool) *ast.Symbol {
+	seen := map[*ast.Symbol]bool{}
+	for symbol != nil && symbol.ValueDeclaration != nil && ast.IsBindingElement(symbol.ValueDeclaration) {
+		if seen[symbol] {
+			return nil
+		}
+		seen[symbol] = true
+		declaration := symbol.ValueDeclaration
+		if !ast.IsObjectBindingPattern(declaration.Parent) || declaration.Initializer() != nil || declaration.AsBindingElement().DotDotDotToken != nil {
+			return nil
+		}
+		variable := declaration.Parent.Parent
+		name, known := checker.Checker_getAccessedPropertyName(typeChecker, declaration)
+		if !known {
+			return nil
+		}
+		if acceptsSource == nil {
+			// Revocation follows native properties in nested, loop and parameter
+			// bindings. A type can disprove exclusivity, never grant safety.
+			symbol = checker.Checker_getPropertyOfType(typeChecker, typeChecker.GetTypeAtLocation(declaration.Parent), name)
+		} else {
+			if !ast.IsVariableDeclaration(variable) || variable.Parent.Flags&ast.NodeFlagsConst == 0 || variable.Initializer() == nil || !acceptsSource(variable.Initializer()) {
+				return nil
+			}
+			symbol = checker.Checker_getPropertyOfType(typeChecker, typeChecker.GetTypeAtLocation(variable.Initializer()), name)
+		}
+	}
+	return symbol
+}
+
+func callReferenceSymbol(node *ast.Node, typeChecker *checker.Checker) *ast.Symbol {
+	node = unwrapCallReference(node)
+	var symbol *ast.Symbol
+	if ast.IsAccessExpression(node) {
+		if name, known := checker.Checker_getAccessedPropertyName(typeChecker, node); known {
+			symbol = checker.Checker_getPropertyOfType(typeChecker, typeChecker.GetTypeAtLocation(node.Expression()), name)
+		}
+	} else if node.Parent != nil && ast.IsShorthandPropertyAssignment(node.Parent) {
+		symbol = checker.Checker_GetShorthandAssignmentValueSymbol(typeChecker, node.Parent)
+	} else {
+		symbol = typeChecker.GetSymbolAtLocation(node)
+	}
+	return symbol
+}
+
+func boundCallTarget(node *ast.Node, program *compiler.Program, typeChecker *checker.Checker) *ast.Node {
+	if !ast.IsCallExpression(node) {
+		return nil
+	}
+	callee := unwrapCallReference(node.AsCallExpression().Expression)
+	if ast.IsAccessExpression(callee) {
+		symbol := callReferenceSymbol(callee, typeChecker)
+		// Follow native Function.bind only, never an application method named bind.
+		if symbol != nil && symbol.Name == "bind" && len(symbol.Declarations) != 0 && utils.Every(symbol.Declarations, func(d *ast.Node) bool {
+			return utils.IsSourceFileDefaultLibrary(program, ast.GetSourceFileOfNode(d))
+		}) {
+			return callee.Expression()
+		}
+	}
+	return nil
+}
+
+func matchesSafeCall(node *ast.Node, specifiers []utils.TypeOrValueSpecifier, program *compiler.Program, typeChecker *checker.Checker) bool {
+	seen := map[*ast.Symbol]bool{}
+	namespaceSeen := map[*ast.Symbol]bool{}
+	var matchesNode func(*ast.Node) bool
+	var matchesSymbol func(*ast.Symbol) bool
+	var matchesNamespace func(*ast.Node) bool
+	matchesNamespace = func(node *ast.Node) bool {
+		node = unwrapCallReference(node)
+		if ast.IsAwaitExpression(node) {
+			expression := unwrapCallReference(node.Expression())
+			if ast.IsImportCall(expression) && len(expression.AsCallExpression().Arguments.Nodes) != 0 {
+				symbol := typeChecker.GetSymbolAtLocation(expression.AsCallExpression().Arguments.Nodes[0])
+				return symbol != nil && symbol.Flags&ast.SymbolFlagsModule != 0
+			}
+		}
+		if ast.IsCallExpression(node) {
+			callee := unwrapCallReference(node.AsCallExpression().Expression)
+			symbol := callReferenceSymbol(callee, typeChecker)
+			if ast.IsAccessExpression(callee) && symbol != nil && utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, utils.TypeOrValueSpecifier{From: utils.TypeOrValueSpecifierFromPackage, Package: "node", Name: []string{"getBuiltinModule"}}, program) {
+				return matchesSafeCall(callee.Expression(), []utils.TypeOrValueSpecifier{{From: utils.TypeOrValueSpecifierFromPackage, Package: "node", Name: []string{"process"}}}, program, typeChecker)
+			}
+		}
+		symbol := callReferenceSymbol(node, typeChecker)
+		if symbol == nil {
+			return false
+		}
+		symbol = checker.SkipAlias(symbol, typeChecker)
+		if namespaceSeen[symbol] {
+			return false
+		}
+		namespaceSeen[symbol] = true
+		defer delete(namespaceSeen, symbol)
+		symbol = bindingReferenceSymbol(symbol, typeChecker, matchesNamespace)
+		if symbol == nil {
+			return false
+		}
+		if symbol.Flags&ast.SymbolFlagsModule != 0 {
+			return true
+		}
+		declaration := symbol.ValueDeclaration
+		return declaration != nil && ast.IsVariableDeclaration(declaration) && declaration.Parent.Flags&ast.NodeFlagsConst != 0 && declaration.Initializer() != nil && matchesNamespace(declaration.Initializer())
+	}
+	matchesSymbol = func(symbol *ast.Symbol) bool {
+		symbol = bindingReferenceSymbol(symbol, typeChecker, matchesNamespace)
+		if symbol == nil {
+			return false
+		}
+		if seen[symbol] {
+			return false
+		}
+		seen[symbol] = true
+		if symbol.Flags&ast.SymbolFlagsAlias != 0 {
+			// A library may itself export a named alias (node:test exports it
+			// as test). Keep that approved export name without trusting a
+			// consumer's local import spelling.
+			target := checker.SkipAlias(symbol, typeChecker)
+			for _, specifier := range specifiers {
+				if utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, specifier, program) &&
+					utils.SymbolMatchesSpecifierNameAndSource(target, symbol.Name, specifier, program) &&
+					slices.ContainsFunc(target.Declarations, isFreeCallDeclaration) {
+					return true
+				}
+			}
+			return matchesSymbol(checker.Checker_getImmediateAliasedSymbol(typeChecker, symbol))
+		}
+		for _, declaration := range symbol.Declarations {
+			// Only free declarations establish ownership. Same-named properties,
+			// methods and function parameters do not inherit a safe-call allowance.
+			parent := declaration.Parent
+			if ast.IsVariableDeclaration(declaration) {
+				if parent == nil || !ast.IsVariableDeclarationList(parent) {
+					continue
+				}
+				if parent.Flags&ast.NodeFlagsConst != 0 && declaration.Initializer() != nil && matchesNode(declaration.Initializer()) {
+					return true
+				}
+			}
+			if !isFreeCallDeclaration(declaration) {
+				continue
+			}
+			for _, specifier := range specifiers {
+				if utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, specifier, program) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	matchesNode = func(node *ast.Node) bool {
+		node = unwrapCallReference(node)
+		if ast.IsCallExpression(node) {
+			if target := boundCallTarget(node, program, typeChecker); target != nil {
+				return matchesNode(target)
+			}
+			return false
+		}
+		// A namespace-shaped type does not prove the receiver's runtime value.
+		if ast.IsAccessExpression(node) && !matchesNamespace(node.Expression()) {
+			return false
+		}
+		return matchesSymbol(callReferenceSymbol(node, typeChecker))
+	}
+	return matchesNode(node)
+}
diff --git a/internal/rules/no_floating_promises/node_test_context.go b/internal/rules/no_floating_promises/node_test_context.go
new file mode 100644
index 0000000..f25a97d
--- /dev/null
+++ b/internal/rules/no_floating_promises/node_test_context.go
@@ -0,0 +1,345 @@
+package no_floating_promises
+
+import (
+	"slices"
+
+	"github.com/microsoft/typescript-go/shim/ast"
+	"github.com/microsoft/typescript-go/shim/checker"
+	"github.com/microsoft/typescript-go/shim/core"
+	"github.com/microsoft/typescript-go/shim/tspath"
+	"github.com/typescript-eslint/tsgolint/internal/rule"
+	"github.com/typescript-eslint/tsgolint/internal/utils"
+)
+
+var nodeRegistrationSpecifiers = []utils.TypeOrValueSpecifier{{From: utils.TypeOrValueSpecifierFromPackage, Package: "node:test", Name: []string{"test", "it", "suite", "describe"}}}
+var nodeSuiteSpecifiers = []utils.TypeOrValueSpecifier{{From: utils.TypeOrValueSpecifierFromPackage, Package: "node:test", Name: []string{"suite", "describe"}}}
+
+// Only global registrations and the nearest proven native suite callback own
+// registration promises. Unknown wrappers, object callbacks and helper calls
+// must remain checked; their runtime test context cannot be inferred safely.
+func nodeSuiteCallbacks(ctx rule.RuleContext) map[*ast.Node]bool {
+	callbacks := map[*ast.Node]bool{}
+	var callbackDeclaration func(*ast.Node, map[*ast.Symbol]bool) *ast.Node
+	var callbackSymbol func(*ast.Symbol, map[*ast.Symbol]bool) *ast.Node
+	callbackDeclaration = func(node *ast.Node, seen map[*ast.Symbol]bool) *ast.Node {
+		node = unwrapCallReference(node)
+		if ast.IsFunctionExpression(node) || ast.IsArrowFunction(node) {
+			return node
+		}
+		if target := boundCallTarget(node, ctx.Program, ctx.TypeChecker); target != nil {
+			return callbackDeclaration(target, seen)
+		}
+		return callbackSymbol(callReferenceSymbol(node, ctx.TypeChecker), seen)
+	}
+	callbackSymbol = func(symbol *ast.Symbol, seen map[*ast.Symbol]bool) *ast.Node {
+		if symbol == nil {
+			return nil
+		}
+		symbol = bindingReferenceSymbol(checker.SkipAlias(symbol, ctx.TypeChecker), ctx.TypeChecker, nil)
+		if symbol == nil || seen[symbol] {
+			return nil
+		}
+		seen[symbol] = true
+		declaration := symbol.ValueDeclaration
+		if declaration != nil {
+			if ast.IsFunctionDeclaration(declaration) || ast.IsFunctionExpression(declaration) {
+				return declaration
+			}
+			if ast.IsVariableDeclaration(declaration) && declaration.Parent.Flags&ast.NodeFlagsConst != 0 && declaration.Initializer() != nil {
+				return callbackDeclaration(declaration.Initializer(), seen)
+			}
+		}
+		return nil
+	}
+	var visit func(*ast.Node) bool
+	visit = func(node *ast.Node) bool {
+		if ast.IsCallExpression(node) {
+			call := node.AsCallExpression()
+			if matchesSafeCall(call.Expression, nodeRegistrationSpecifiers, ctx.Program, ctx.TypeChecker) {
+				isSuite := matchesSafeCall(call.Expression, nodeSuiteSpecifiers, ctx.Program, ctx.TypeChecker)
+				for _, argument := range call.Arguments.Nodes {
+					if callback := callbackDeclaration(argument, map[*ast.Symbol]bool{}); callback != nil && ast.GetSourceFileOfNode(callback) == ctx.SourceFile {
+						// A callback also registered as a test cannot receive a
+						// suite-only exemption, regardless of traversal order.
+						previous, exists := callbacks[callback]
+						callbacks[callback] = isSuite && (!exists || previous)
+					}
+				}
+			}
+		}
+		node.ForEachChild(visit)
+		return false
+	}
+	// A named or bound suite callback may be registered in another source file.
+	for _, file := range ctx.Program.SourceFiles() {
+		if !file.IsDeclarationFile && !ctx.Program.IsSourceFileFromExternalLibrary(file) {
+			visit(file.AsNode())
+		}
+	}
+	// A named callback belongs exclusively to its suite only when every value
+	// reference stays in a native suite registration or immutable alias chain.
+	// Passing it elsewhere (including shorthand properties) makes ownership unknown.
+	revokeModule := func(t *checker.Type) {
+		for _, property := range checker.Checker_getPropertiesOfType(ctx.TypeChecker, t) {
+			if callback := callbackSymbol(property, map[*ast.Symbol]bool{}); callbacks[callback] {
+				callbacks[callback] = false
+			}
+		}
+	}
+	var checkReferences func(*ast.Node) bool
+	checkReferences = func(node *ast.Node) bool {
+		if ast.IsCallExpression(node) {
+			if recognized, base := nodeRequireOrigin(node.AsCallExpression().Expression, ctx); recognized {
+				// CommonJS loads have no import symbol, and a structural annotation
+				// can erase the loader's Require type. Native resolution identifies
+				// exact relative runtime targets; opaque or outside-program targets revoke this
+				// file's known exports rather than infer suite-only ownership.
+				module := ctx.SourceFile.AsNode().Symbol()
+				if arguments := node.AsCallExpression().Arguments.Nodes; base != nil && len(arguments) != 0 && ast.IsStringLiteralLike(arguments[0]) {
+					specifier := arguments[0].Text()
+					// TypeScript may select package "types" or substitute .ts for
+					// a .js operand. Neither proves what Node will actually load.
+					if tspath.PathIsRelative(specifier) && tspath.GetAnyExtensionFromPath(specifier, nil, false) != "" {
+						if resolved := ctx.Program.ResolveModuleName(specifier, base.FileName(), core.ResolutionModeCommonJS); resolved != nil && tspath.GetNormalizedAbsolutePath(resolved.ResolvedFileName, tspath.GetDirectoryPath(base.FileName())) == tspath.GetNormalizedAbsolutePath(specifier, tspath.GetDirectoryPath(base.FileName())) {
+							if target := ctx.Program.GetSourceFile(resolved.ResolvedFileName); target != nil && !target.IsDeclarationFile && !ctx.Program.IsSourceFileFromExternalLibrary(target) {
+								module = target.AsNode().Symbol()
+							}
+						}
+					}
+				}
+				if module != nil {
+					revokeModule(ctx.TypeChecker.GetTypeOfSymbol(module))
+				}
+			}
+		}
+		if ast.IsCallExpression(node) || (ast.IsIdentifier(node) || ast.IsAccessExpression(node)) && !ast.IsDeclarationNameOrImportPropertyName(node) && !ast.IsPartOfTypeNode(node) {
+			if recognized, _ := nodeRequireOrigin(node, ctx); recognized && !isNodeRequireValueReference(node, ctx) {
+				if module := ctx.SourceFile.AsNode().Symbol(); module != nil {
+					revokeModule(ctx.TypeChecker.GetTypeOfSymbol(module))
+				}
+			}
+		}
+		if (ast.IsIdentifier(node) || ast.IsAccessExpression(node)) && !ast.IsDeclarationNameOrImportPropertyName(node) && !ast.IsPartOfTypeNode(node) {
+			// Native VM execution is opaque: code strings or handed-off native
+			// execution values can load exports without a compiler import edge.
+			symbol := callReferenceSymbol(node, ctx.TypeChecker)
+			if symbol != nil {
+				symbol = bindingReferenceSymbol(checker.SkipAlias(symbol, ctx.TypeChecker), ctx.TypeChecker, nil)
+				if symbol != nil && utils.Some(nodeVmExecutionSpecifiers, func(specifier utils.TypeOrValueSpecifier) bool {
+					return utils.SymbolMatchesSpecifierNameAndSource(symbol, symbol.Name, specifier, ctx.Program)
+				}) {
+					if module := ctx.SourceFile.AsNode().Symbol(); module != nil {
+						revokeModule(ctx.TypeChecker.GetTypeOfSymbol(module))
+					}
+				}
+			}
+		}
+		if ast.IsImportCall(node) {
+			// Resolve the actual imported module, not its contextual/awaited type.
+			// Promise combinators, callbacks and nested containers are opaque.
+			var module *ast.Symbol
+			if arguments := node.AsCallExpression().Arguments.Nodes; len(arguments) != 0 {
+				module = ctx.TypeChecker.GetSymbolAtLocation(arguments[0])
+			}
+			known := module != nil && module.Flags&ast.SymbolFlagsModule != 0
+			reference := node
+			for reference.Parent != nil && ast.IsParenthesizedExpression(reference.Parent) {
+				reference = reference.Parent
+			}
+			if !known || reference.Parent == nil || !ast.IsAwaitExpression(reference.Parent) || !isSuiteModuleReference(reference.Parent, ctx) {
+				if !known {
+					module = ctx.SourceFile.AsNode().Symbol()
+				}
+				if module != nil {
+					revokeModule(ctx.TypeChecker.GetTypeOfSymbol(module))
+				}
+			}
+		}
+		if ast.IsIdentifier(node) || ast.IsAccessExpression(node) || ast.IsAwaitExpression(node) {
+			if ast.IsShorthandPropertyAssignment(node.Parent) || !ast.IsDeclarationNameOrImportPropertyName(node) && !ast.IsPartOfTypeNode(node) {
+				callback := callbackDeclaration(node, map[*ast.Symbol]bool{})
+				if callbacks[callback] && !isSuiteCallbackReference(node, ctx) {
+					callbacks[callback] = false
+				}
+				// A module object can carry any exported callback. Unknown uses
+				// must revoke every matching export, rather than guess its key.
+				t := ctx.TypeChecker.GetTypeAtLocation(node)
+				if symbol := checker.Type_symbol(t); symbol != nil && symbol.Flags&ast.SymbolFlagsModule != 0 && !isSuiteModuleReference(node, ctx) {
+					revokeModule(t)
+				}
+			}
+		}
+		node.ForEachChild(checkReferences)
+		return false
+	}
+	for _, file := range ctx.Program.SourceFiles() {
+		if !file.IsDeclarationFile && !ctx.Program.IsSourceFileFromExternalLibrary(file) {
+			checkReferences(file.AsNode())
+		}
+	}
+	return callbacks
+}
+
+var nodeRequireSpecifiers = []utils.TypeOrValueSpecifier{{From: utils.TypeOrValueSpecifierFromPackage, Package: "node", Name: []string{"Require", "NodeRequire"}}}
+var nodeRequireValueSpecifier = utils.TypeOrValueSpecifier{From: utils.TypeOrValueSpecifierFromPackage, Package: "node", Name: []string{"require"}}
+var nodeCreateRequireSpecifiers = []utils.TypeOrValueSpecifier{
+	{From: utils.TypeOrValueSpecifierFromPackage, Package: "node:module", Name: []string{"createRequire"}},
+	{From: utils.TypeOrValueSpecifierFromPackage, Package: "module", Name: []string{"createRequire"}},
+}
+
+var nodeVmExecutionSpecifiers = []utils.TypeOrValueSpecifier{
+	{From: utils.TypeOrValueSpecifierFromPackage, Package: "node:vm", Name: []string{"runInThisContext", "runInContext", "runInNewContext", "Script", "compileFunction", "SourceTextModule"}},
+	{From: utils.TypeOrValueSpecifierFromPackage, Package: "vm", Name: []string{"runInThisContext", "runInContext", "runInNewContext", "Script", "compileFunction", "SourceTextModule"}},
+}
+
+// A Require type proves loader capability, not its resolution directory. Only
+// actual native globals or createRequire(import.meta.url) establish that base;
+// opaque factories/receivers retain recognition but cannot resolve a target.
+func nodeRequireOrigin(node *ast.Node, ctx rule.RuleContext) (bool, *ast.SourceFile) {
+	seen := map[*ast.Symbol]bool{}
+	var visit func(*ast.Node) (bool, *ast.SourceFile)
+	visit = func(node *ast.Node) (bool, *ast.SourceFile) {
+		node = unwrapCallReference(node)
+		if target := boundCallTarget(node, ctx.Program, ctx.TypeChecker); target != nil {
+			return visit(target)
+		}
+		if ast.IsCallExpression(node) && matchesSafeCall(node.AsCallExpression().Expression, nodeCreateRequireSpecifiers, ctx.Program, ctx.TypeChecker) {
+			if arguments := node.AsCallExpression().Arguments.Nodes; len(arguments) != 0 {
+				argument := unwrapCallReference(arguments[0])
+				if ast.IsAccessExpression(argument) && ast.IsImportMeta(argument.Expression()) {
